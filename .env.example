# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
# DB_USERNAME is also accepted by the backend.
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Weather forecast service
WEATHERAPI_KEY=

# Brevo transactional email
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=bayanalertcalapan@gmail.com
BREVO_SENDER_NAME=BayanAlert System

# Public application URLs used for verification links and report media
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://127.0.0.1:3000