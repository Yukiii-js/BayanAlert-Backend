# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
# Required in production; generate a unique key with:
# php -r "echo bin2hex(random_bytes(32));"
APP_KEY=
# Set APP_ENV=production on Render to disable localhost CORS defaults.
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
# DB_USERNAME is also accepted by the backend.
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
# Optional CA file for verifying managed MySQL server certificates (recommended for Aiven).
DB_SSL_CA=
DB_PREFIX=

# For API
# Generate with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
REFRESH_TOKEN_KEY=
# Comma-separated exact browser origins; local Vite origins are only added outside production.
FRONTEND_ORIGINS=

# Weather forecast service
WEATHERAPI_KEY=

# Brevo transactional email
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=bayanalertcalapan@gmail.com
BREVO_SENDER_NAME=BayanAlert System

# Public application URLs used for verification links and report media
FRONTEND_URL=http://localhost:5173
APP_BASE_URL=http://127.0.0.1:3000